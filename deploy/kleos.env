# Debug
#RUST_BACKTRACE=full
RUST_LOG=info

# Boostrap
#KLEOS_BOOTSTRAP_SECRET=x975..

# Key
KLEOS_API_KEY_PEPPER=<generate: openssl rand -hex 32>

# Binding LAN
KLEOS_HOST=0.0.0.0
KLEOS_PORT=4200

# Embedding LLM
KLEOS_EMBEDDING_OFFLINE_ONLY=1
KLEOS_EMBEDDING_BACKEND=openai
KLEOS_EMBEDDING_OPENAI_BASE_URL=http://192.168.10.16:11434/v1
#KLEOS_EMBEDDING_OPENAI_BASE_URL=http://192.168.10.15:4000
KLEOS_EMBEDDING_OPENAI_API_KEY=<your-ollama-api-key>
KLEOS_EMBEDDING_OPENAI_MODEL=bge-m3
# KLEOS_EMBEDDING_DIM=1024             # déjà la valeur par défaut
# KLEOS_VECTOR_DIMENSIONS=1024         # déjà la valeur par défaut

# SI nomic-embed-text:v1.5 à la place :
# KLEOS_EMBEDDING_OPENAI_MODEL=nomic-embed-text:v1.5
# KLEOS_EMBEDDING_DIM=768
# KLEOS_VECTOR_DIMENSIONS=768

# Données
KLEOS_DATA_DIR=/var/lib/kleos

# LLM prompts overlay (Patch 15) -- override des prompts hardcodes via fichiers
# .txt. Cascade de resolution :
#   1. KLEOS_LLM_PROMPT_REPOSITORY (path explicite) si defini
#   2. <KLEOS_DATA_DIR>/prompts si le dossier existe
#   3. embedded only (defaut, comportement upstream)
# Layout: <repo>/<service>/<purpose>/{system,user}.txt
# Cache : TTL 5s + invalidation par mtime. Pas besoin de restart pour reload.
#KLEOS_LLM_PROMPT_REPOSITORY=/var/lib/kleos/prompts

# GUI
KLEOS_GUI_BUILD_DIR=/usr/local/share/kleos/gui-build
KLEOS_GUI_PASSWORD=1

# Ollama
OLLAMA_URL=http://192.168.10.16:11434/v1/chat/completions
OLLAMA_MODEL=ministral-14b-q8-tools

# Engram Setup
KLEOS_LLM_MODEL=ministral-14b-q8-tools
KLEOS_LLM_URL=http://192.168.10.16:11434/api/generate

# DB
KLEOS_DB_PATH=/var/lib/kleos/kleos.db

# Encryption
KLEOS_ENCRYPTION_MODE=env
KLEOS_DB_KEY=<generate: openssl rand -hex 32>

# SearXNG
KLEOS_WEB_SEARCH_URL=http://192.168.10.22:8080